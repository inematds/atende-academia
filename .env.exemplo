# Copie para .env e preencha. Vazio = desligado (sem Evolution: caixa de saída simulada; sem Telegram: nada vai ao grupo).
# Endereço público do sistema, sem barra final (links de exercício enviados ao aluno).
PUBLIC_URL=
# Pasta dos MP4 dos exercícios dentro do container (padrão web/exercicios). Ex.: /dados/mp4
EXERCICIOS_MP4_DIR=
# WhatsApp pela Evolution API (endereço interno da Evolution, sem barra final).
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=
# Segredo do caminho do webhook: /webhook/evolution/<segredo>
WEBHOOK_SEGREDO=
# Atendimento da equipe pelo Telegram (endereço da API do Telegram, sem barra final).
TELEGRAM_API_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Mesmo valor passado como secret_token no setWebhook.
TELEGRAM_SEGREDO=

    assert api.get("/api/reservas?data=2026-10-08")[1]["reservas"][0]["status"] == "reservada"   # reserva feita continua
    assert api.put("/api/grade/pil-qua-9", {"vagas": 3})[0] == 200
    assert api.ocorrencia("2026-10-07", "pil-qua-9")["livres"] == 3



import json
import os
import pathlib
import shutil
import signal
import subprocess
import threading
import unicodedata
import urllib.error
import urllib.request

import pytest

RAIZ = pathlib.Path(__file__).resolve().parent.parent
FIXTURE = pathlib.Path(__file__).resolve().parent / "fixtures" / "academia.json"
